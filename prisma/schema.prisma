// Prisma schema for FakeBook (FakeFB)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  emailVerified DateTime?
  isNpc        Boolean   @default(false)
  persona      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts        Post[]
  sessions     Session[]
  verifyTokens VerificationToken[]
  messages     Message[]
  postLikes    PostLike[]
  comments     Comment[]
  stories      Story[]
  storyViews   StoryView[]
  conversationsAsUser Conversation[]      @relation("ConversationsAsUser")
  conversationMemberships ConversationMember[] @relation("ConversationMembers")
}

model Conversation {
  id                String   @id @default(cuid())
  userId            String
  name              String?
  type              String   @default("dm") // dm | group
  opencodeSessionId String?
  opencodeConfigHash String?
  lastReadAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User                 @relation("ConversationsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]

  @@index([userId])
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  type           String    @default("text") // text | sticker | photo
  content        String
  replyToId      String?
  reactions      String    @default("{}") // JSON: { userId: emoji }
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id        String   @id @default(cuid())
  content   String
  image     String?
  authorId  String
  createdAt DateTime @default(now())

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments Comment[]

  @@index([authorId])
  @@index([createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Story {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  emoji     String?
  color     String?
  image     String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([createdAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  userId   String
  viewedAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId])
}

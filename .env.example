# ===== Database =====
DATABASE_URL="file:./dev.db"

# ===== Resend (https://resend.com/api-keys) =====
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address.
#   1. Sandbox (only delivers to your own Resend account email): onboarding@resend.dev
#   2. Your own verified domain:  "FakeBook <noreply@yourdomain.com>"
EMAIL_FROM="FakeBook <onboarding@resend.dev>"

# ===== App =====
APP_URL="http://localhost:3000"

# ===== NPC 聊天（用 OpenCode 當 LLM 引擎） =====
# 使用的模型，格式 provider/model
OPENCODE_MODEL="opencode/minimax-m3.1-flash-free"
# NPC 各自的工作目錄（會在這裡產生 opencode.json 與對話 session）
# OPENCODE_NPC_DIR="C:/temp/fakebook-npc"
